{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build",
    "nixpacksPlan": {
      "phases": {
        "install": {
          "cmds": [
            "npm ci --include=dev"
          ]
        }
      }
    }
  },
  "deploy": {
    "startCommand": "npx prisma db push --schema=backend/prisma/schema.prisma && npm --workspace=backend run start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
